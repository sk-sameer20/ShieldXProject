# ShieldX SOC Backend Configuration
# Copy this file to .env and configure as needed.

APP_NAME="ShieldX SOC Enclave Backend"
APP_VERSION="1.0.0"
DEBUG=false

# Server binding
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON array)
# Wildcard "*" is strictly disallowed
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database URLs
SHIELDX_SYNC_DB_URL=sqlite:///./shieldx.db
SHIELDX_ASYNC_DB_URL=sqlite+aiosqlite:///./shieldx.db

# Telemetry streaming interval in milliseconds
WS_BATCH_RATE_MS=1000
